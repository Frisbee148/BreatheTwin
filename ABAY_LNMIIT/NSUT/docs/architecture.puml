@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif
skinparam defaultFontSize 11
skinparam defaultTextAlignment left
skinparam arrowThickness 2.0
skinparam arrowFontSize 11
skinparam arrowFontColor #0F172A

skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #64748B
skinparam packageFontColor #0F172A
skinparam packageFontStyle bold
skinparam packageFontSize 13

skinparam cardBackgroundColor #FFFFFF
skinparam cardBorderColor #3B82F6
skinparam cardFontColor #0F172A
skinparam cardFontSize 11

skinparam databaseBackgroundColor #EFF6FF
skinparam databaseBorderColor #1D4ED8
skinparam databaseFontColor #0F172A
skinparam databaseFontSize 11

top to bottom direction

package "01. Multimodal Data Ingestion & Storage" as P1 {
  card EHR #F0FDF4 [
    <b>Stream 01: Static EHR</b>
    ----
    • 60 Clinical Baseline Features
    • Spirometry: FEV1%, FEV1/FVC, PEF
    • Prescribed Controller Regimen & History
    • Location: <i>aasthma/dataset/data/static/</i>
  ]

  card WEAR #F0FDF4 [
    <b>Stream 02: Wearable Telemetry</b>
    ----
    • 20 Continuous Channels (12h Lookback)
    • SpO2, Heart Rate, HRV (rMSSD), RR
    • Nocturnal Awakenings & SABA Inhaler Logs
    • Location: <i>aasthma/dataset/data/dynamic/</i>
  ]

  database DB #EFF6FF [
    <b>PostgreSQL 16 Database</b>
    ----
    • patients & timeseries_telemetry
    • clinical_events & severity labels
    • patient_daily_logs (PRO check-ins)
    • Experience Replay Buffer (outliers)
    • Location: <i>aasthma/database/models.py</i>
  ]

  card AQI #F0FDF4 [
    <b>Stream 03: Environment (AQI)</b>
    ----
    • Ambient PM2.5, PM10, AQI Index
    • 70+ CPCB Monitoring Stations & Open-Meteo
    • Simulation Replay Clock (t = 12h..239h)
    • Location: <i>aasthma/simulation/clock.py</i>
  ]

  EHR -[hidden]right-> WEAR
  WEAR -[hidden]right-> DB
  DB -[hidden]right-> AQI

  WEAR .[#1D4ED8]right.> DB : <color:#1D4ED8>Persist Streams</color>
  AQI .[#1D4ED8]left.> DB : <color:#1D4ED8>Persist AQI</color>
}

package "02. Hybrid Digital Twin Engine" as P2 {
  package "Neural & Tabular Machine Learning Pipeline" as P2_LEFT {
    card S1 #EFF6FF [
      <b>Stage 1: Base Multimodal Predictors</b>
      ----
      <b>Stage 1A: Dilated TCN Fusion Model</b> (<i>digital_twin_model.pt</i>)
      • StaticMLPEncoder (60D -> 64D Embedding)
      • Conv1DDynamicEncoder (20 channels x 12h) + 3 Dilated Blocks (d = 1, 2, 4)
      • Heads: P(24h), P(48h), Severity (0..3)
      ----
      <b>Stage 1B: XGBoost Multi-Target Suite</b> (<i>gb_digital_twin_models.pkl</i>)
      • Tabular Gradient-Boosted Decision Trees
      • Rolling Window Statistics + Temporal Lag Shifts (t-2..t+2)
      • Heads: P(24h), P(48h), Severity (0..3)
    ]

    card META #FEF9C3 [
      <b>Stage 2: Stacking MLP Meta-Learner</b>
      ----
      • RespiTwinMLPMetaLearner (12D -> 32D -> 16D -> 3 Heads)
      • Calibrates 12D Probabilities: [tcn_24h, xgb_24h, tcn_48h, xgb_48h, ...]
      • 90% Conformal Prediction Intervals & Local SHAP Attribution
      • <b>Held-Out Results: 24h ROC-AUC = 0.940 | 48h ROC-AUC = 0.943 | F1 = 0.844</b>
      • Location: <i>aasthma/training/ensemble.py (meta_ensemble_model.pt)</i>
    ]

    S1 -[#2563EB]down-> META : <color:#2563EB><b>12D Predicted Probabilities & Latent Embeddings</b></color>
  }

  package "Biophysical Simulation & Clinical Adaptation" as P2_RIGHT {
    card ODE #FEF3C7 [
      <b>Mechanistic Airway Simulator (Latent ODE)</b>
      ----
      • dI/dt = -k·I(t) + a·Dose_PM(t) + b·Trigger(t) + d_sys - c·Controller(t) + σ·ξ(t)
      • Euler-Maruyama Numerical SDE Integration (dt = 1.0h)
      • Continuous Latent Mucosal Inflammation State: I(t) ∈ [0.05, 1.0]
      • Counterfactual What-If Sandbox: Stay Indoors, N95, HEPA, ICS Step-Up
      • Re-scores Counterfactual Trajectories with Latency < 65 ms
      • Location: <i>aasthma/simulation/mechanistic_simulator.py</i>
    ]

    card LLM #F3E8FF [
      <b>Stage 3: LLM Clinical Extractor & Retraining</b>
      ----
      • Parses free-text notes (Typhoid, Dengue, Dehydration) into ODE deltas
      • Doctor-verified outliers stored in PostgreSQL Experience Replay Buffer
      • Elastic Weight Consolidation (EWC) Retraining without catastrophic forgetting
      • Pydantic-validated Copilot Reports (precautions, breathing exercises, red flags)
      • Location: <i>aasthma/llm/clinical_extractor.py & aasthma/llm/llm.py</i>
    ]

    ODE -[hidden]right-> LLM

    LLM .[#7C3AED]left.> ODE : <color:#7C3AED><b>Extracted ODE Modifiers</b></color>
  }

  P2_LEFT -[hidden]right-> P2_RIGHT

  ' Horizontal cross-coupling
  META <.[#D97706,norank].> ODE : <color:#D97706><b>Counterfactual Rescoring (Latent State Coupling)</b></color>
  LLM .[#7C3AED,norank].> META : <color:#7C3AED><b>EWC Continual Retraining Feed</b></color>
}

package "03. Service Gateway & User Interfaces" as P3 {
  card API #F1F5F9 [
    <b>FastAPI Service Layer (:8000)</b>
    ----
    • REST Endpoints: /api/patients, /api/what-if, /api/clock, /api/copilot-report
    • Note Adaptation & Continual Retrain: /api/patients/{id}/clinical-note, /api/model/adapt-outliers
    • PostgreSQL Dual-Role RBAC Authentication: Doctor & Patient Session Guard
    • Location: <i>aasthma/server.py</i>
  ]

  package "Next.js 16 Web Applications (:3000)" as CLIENTS {
    card DOC #ECFDF5 [
      <b>Treating Doctor Portal</b>
      ----
      • /patients: Cohort Risk Triage Roster & 240h Simulation Replay Clock
      • /patients/[id]: 3D GLB Anatomical Lung & GLSL Thermal Inflammation Viewer
      • /patients/[id]/forecast: 24h & 48h Conformal Risk Fan Chart & SHAP Drivers
      • /patients/[id]/what-if: Interactive Counterfactual Intervention Sandbox
      • /patients/[id]/adaptation: Free-Text Note Parser & EWC Retraining Studio
      • /benchmarks & /assumptions: Physiological Ablations & Auditable Citations
    ]

    card PAT #ECFDF5 [
      <b>Asthma Patient Portal</b>
      ----
      • /patient-portal: Personal 24h & 48h Risk Guidance Card
      • Real-Time Local CPCB Station AQI & Smog Inversion Advisories
      • Daily Self-Reported Outcomes (PRO): SABA Puffs & Symptom Check-ins
      • Clinician-Verified Copilot Report Access (Precautions & Breathing Plans)
      • Role-Isolated Patient Authentication (PT-8821, PT-4409, PT-1923)
    ]

    DOC -[hidden]right-> PAT
  }

  API -[#059669]down-> DOC : <color:#059669><b>Doctor Telemetry & Digital Twin Stream</b></color>
  API -[#059669]down-> PAT : <color:#059669><b>Patient Risk Status & Copilot Guidance</b></color>
}

' Enforce vertical stack
P1 -[hidden]down-> P2
P2 -[hidden]down-> P3

' Inter-package data flow
EHR -[#059669]down-> S1 : <color:#059669><b>Static Baseline (60D)</b></color>
WEAR -[#059669]down-> S1 : <color:#059669><b>Telemetry Series (20ch x 12h)</b></color>
AQI -[#D97706]down-> ODE : <color:#D97706><b>Ambient PM2.5 Inhaled Dose</b></color>

META -[#2563EB]down-> API : <color:#2563EB><b>Calibrated 24h/48h Forecast & Conformal Bounds</b></color>
ODE -[#D97706]down-> API : <color:#D97706><b>Airway Mucosal Inflammation State I(t)</b></color>
LLM -[#7C3AED]down-> API : <color:#7C3AED><b>Synthesized Clinical Copilot Reports</b></color>

@enduml
