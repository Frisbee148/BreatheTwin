# BreathTwin Environment Configuration Template
# Copy this file to .env (for Docker Compose) and aasthma/.env (for FastAPI backend)

# PostgreSQL Database Configuration
POSTGRES_USER=synclave
POSTGRES_PASSWORD=synclave
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=breathtwin
DATABASE_URL=postgresql://synclave:synclave@localhost:5432/breathtwin

# Application Secret Key
SECRET_KEY=breathtwin-development-insecure-secret-key-change-in-production

# Optional: External LLM Clinical Copilot Keys
# Leave empty to utilize offline deterministic regex and clinical ontology fallback
OPENAI_API_KEY=
HF_TOKEN=
